#!/bin/bash
set -euo pipefail

TARGET_ROOT="${3:-/}"
if [ -z "$TARGET_ROOT" ]; then
  TARGET_ROOT="/"
fi

target_path() {
  local path="$1"
  if [ "$TARGET_ROOT" = "/" ]; then
    printf '%s\n' "$path"
  else
    printf '%s%s\n' "${TARGET_ROOT%/}" "$path"
  fi
}

stop_existing_menu_app() {
  local menu_binary="/Applications/NTFS Access.app/Contents/MacOS/NTFSMenuApp"
  local pid=""
  while IFS= read -r pid; do
    [ -n "$pid" ] || continue
    /bin/kill "$pid" >/dev/null 2>&1 || true
  done < <(/usr/bin/pgrep -f "$menu_binary" 2>/dev/null || true)
}

prepare_livejob_directory() {
  local path="$1"
  local mode="$2"

  if [ -L "$path" ]; then
    rm -f "$path" || true
  fi
  mkdir -p "$path"
  chown root:wheel "$path" 2>/dev/null || true
  chmod "$mode" "$path" 2>/dev/null || true
}

DAEMON_PLIST="$(target_path "/Library/LaunchDaemons/com.ntfsaccess.mountd.plist")"
LIVEJOB_PLIST="$(target_path "/Library/LaunchDaemons/com.ntfsaccess.livejob.plist")"
AGENT_PLIST="$(target_path "/Library/LaunchAgents/com.ntfsaccess.menu.plist")"
APP_PATH="$(target_path "/Applications/NTFS Access.app")"
APP_SUPPORT="$(target_path "/Library/Application Support/NTFSAccess")"
FILESYSTEM_BUNDLE="$(target_path "/Library/Filesystems/ntfsaccess.fs")"
TOOLCHAIN_ROOT="$(target_path "/Library/NTFSAccess")"
LIVEJOB_STAGE="$(target_path "/Users/Shared/NTFSAccessLiveBatch")"

repair_privacy_sensitive_install_paths() {
  if [ -d "$APP_PATH" ]; then
    chown -R root:wheel "$APP_PATH" || true
    chmod -R a+rX "$APP_PATH" || true
    find "$APP_PATH/Contents/MacOS" -type f -maxdepth 1 -exec chmod 755 {} + 2>/dev/null || true
    xattr -cr "$APP_PATH" 2>/dev/null || true
  fi

  if [ -d "$FILESYSTEM_BUNDLE" ]; then
    chown -R root:wheel "$FILESYSTEM_BUNDLE" || true
    chmod -R a+rX "$FILESYSTEM_BUNDLE" || true
    xattr -cr "$FILESYSTEM_BUNDLE" 2>/dev/null || true
  fi

  if [ -d "$TOOLCHAIN_ROOT" ]; then
    chown -R root:wheel "$TOOLCHAIN_ROOT" || true
    chmod -R a+rX "$TOOLCHAIN_ROOT" || true
    xattr -cr "$TOOLCHAIN_ROOT" 2>/dev/null || true
  fi

  if [ -f "$DAEMON_PLIST" ]; then
    chown root:wheel "$DAEMON_PLIST" || true
    chmod 644 "$DAEMON_PLIST" || true
    xattr -c "$DAEMON_PLIST" 2>/dev/null || true
  fi

  if [ -f "$LIVEJOB_PLIST" ]; then
    chown root:wheel "$LIVEJOB_PLIST" || true
    chmod 644 "$LIVEJOB_PLIST" || true
    xattr -c "$LIVEJOB_PLIST" 2>/dev/null || true
  fi

  if [ -f "$AGENT_PLIST" ]; then
    chown root:wheel "$AGENT_PLIST" || true
    chmod 644 "$AGENT_PLIST" || true
    xattr -c "$AGENT_PLIST" 2>/dev/null || true
  fi
}

wait_for_service_unloaded() {
  local label="$1"
  local seconds="$2"
  local waited=0

  while launchctl print "system/$label" >/dev/null 2>&1; do
    if [ "$waited" -ge "$seconds" ]; then
      echo "Warning: $label did not unload within ${seconds}s"
      return 1
    fi
    sleep 1
    waited=$((waited + 1))
  done
  return 0
}

bootstrap_system_service_with_retry() {
  local label="$1"
  local plist="$2"
  local attempt=1

  while [ "$attempt" -le 5 ]; do
    if launchctl bootstrap system "$plist"; then
      launchctl enable "system/$label" || true
      launchctl kickstart -k "system/$label" || true
      return 0
    fi

    echo "Warning: bootstrap attempt $attempt failed for $label; retrying"
    launchctl bootout "system/$label" >/dev/null 2>&1 || true
    launchctl bootout system "$plist" >/dev/null 2>&1 || true
    wait_for_service_unloaded "$label" 10 || true
    sleep 2
    attempt=$((attempt + 1))
  done

  echo "Error: unable to bootstrap $label after retries" >&2
  return 1
}

consume_stale_live_job_trigger() {
  rm -f "$LIVEJOB_STAGE/requests/live-job.trigger" 2>/dev/null || true
}

mkdir -p "$APP_SUPPORT"
chmod 755 "$APP_SUPPORT"
rm -f "$APP_SUPPORT/mountd" 2>/dev/null || true
prepare_livejob_directory "$LIVEJOB_STAGE" 755
prepare_livejob_directory "$LIVEJOB_STAGE/requests" 1777
prepare_livejob_directory "$LIVEJOB_STAGE/logs" 755
if [ -e "$LIVEJOB_STAGE/live-job.conf" ] && [ ! -e "$LIVEJOB_STAGE/requests/live-job.conf" ]; then
  mv "$LIVEJOB_STAGE/live-job.conf" "$LIVEJOB_STAGE/requests/live-job.conf" 2>/dev/null || true
fi
if [ -e "$LIVEJOB_STAGE/live-job.trigger" ] && [ ! -e "$LIVEJOB_STAGE/requests/live-job.trigger" ]; then
  mv "$LIVEJOB_STAGE/live-job.trigger" "$LIVEJOB_STAGE/requests/live-job.trigger" 2>/dev/null || true
fi
if [ -f "$LIVEJOB_STAGE/requests/live-job.conf" ]; then
  chmod 644 "$LIVEJOB_STAGE/requests/live-job.conf" 2>/dev/null || true
fi
if [ -f "$LIVEJOB_STAGE/requests/live-job.trigger" ]; then
  chmod 644 "$LIVEJOB_STAGE/requests/live-job.trigger" 2>/dev/null || true
fi
consume_stale_live_job_trigger

if [ -d "$FILESYSTEM_BUNDLE" ]; then
  chmod 755 "$FILESYSTEM_BUNDLE"
  chmod 755 "$FILESYSTEM_BUNDLE/Contents"
  chmod 755 "$FILESYSTEM_BUNDLE/Contents/Resources"
  chmod 755 "$FILESYSTEM_BUNDLE/Contents/Resources/mount_ntfsaccess" || true
  chmod 755 "$FILESYSTEM_BUNDLE/Contents/Resources/ntfsaccess.util" || true
  chmod 755 "$FILESYSTEM_BUNDLE/Contents/Resources/newfs_ntfsaccess" || true
  chmod 644 "$FILESYSTEM_BUNDLE/Contents/Info.plist" || true
fi

if [ "$TARGET_ROOT" != "/" ]; then
  echo "Skipped launchctl bootstrap for alternate install target: $TARGET_ROOT"
  exit 0
fi

stop_existing_menu_app
repair_privacy_sensitive_install_paths

if [ -f "$DAEMON_PLIST" ]; then
  launchctl bootout system "$DAEMON_PLIST" >/dev/null 2>&1 || true
  launchctl bootout system/com.ntfsaccess.mountd >/dev/null 2>&1 || true
  wait_for_service_unloaded com.ntfsaccess.mountd 30 || true
  bootstrap_system_service_with_retry com.ntfsaccess.mountd "$DAEMON_PLIST"
fi

if [ -f "$LIVEJOB_PLIST" ]; then
  launchctl bootout system "$LIVEJOB_PLIST" >/dev/null 2>&1 || true
  launchctl bootout system/com.ntfsaccess.livejob >/dev/null 2>&1 || true
  wait_for_service_unloaded com.ntfsaccess.livejob 30 || true
  bootstrap_system_service_with_retry com.ntfsaccess.livejob "$LIVEJOB_PLIST"
fi

if [ -f "$AGENT_PLIST" ]; then
  console_uid="$(stat -f '%u' /dev/console 2>/dev/null || echo '')"
  if [ -n "$console_uid" ] && [ "$console_uid" != "0" ]; then
    launchctl bootout "gui/$console_uid" "$AGENT_PLIST" >/dev/null 2>&1 || true
    launchctl bootstrap "gui/$console_uid" "$AGENT_PLIST" >/dev/null 2>&1 || true
    launchctl kickstart -k "gui/$console_uid/com.ntfsaccess.menu" >/dev/null 2>&1 || true
  fi
fi

/usr/sbin/diskutil listFilesystems >/dev/null 2>&1 || true

exit 0
